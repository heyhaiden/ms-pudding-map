# Mapbox public token (pk.…). Restrict it to this site's URL in the Mapbox account.
# Copy this file to .env. GitHub Actions reads the repository secret of the same name.
MAPBOX_TOKEN=

# PostHog analytics configuration.
POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
POSTHOG_HOST=https://your-posthog-host
